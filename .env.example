# ローカル開発用の設定。cp .env.example .env して値を書き換える。
# 本番（Cloud Run）では Secret Manager と環境変数で渡すので .env は使わない。
# .env は .gitignore 済み。コミットしないこと。

# ★ 必ず変える ------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...          # https://console.anthropic.com/ で発行
GCP_PROJECT=your-project-id           # BigQuery を置く Google Cloud プロジェクト ID

# 必要なら変える ----------------------------------------------------------
ANTHROPIC_MODEL=claude-sonnet-5       # 既定モデル。UI から Opus 5 / Haiku 4.5 に切替可
BQ_DATASET=partd                      # データセット名。変えるなら sql/ddl.sql と app/prompts も
BQ_LOCATION=US                        # データセットのロケーション
RUN_REGION=us-central1                # Cloud Run / Artifact Registry のリージョン（deploy.sh）
RUN_SERVICE=medicare-partd-text-to-sql  # Cloud Run のサービス名（deploy.sh）

# 上限（ガード）----------------------------------------------------------
MAX_BYTES_BILLED=2147483648           # 2 GiB。1 GiB だと provider_drug のクエリが見積もり段階で拒否される
MAX_QUESTIONS_PER_SESSION=20          # 1 セッションの質問数（API 費用の上限）
